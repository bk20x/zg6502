with "config/zg6502_config.gpr";
project Zg6502 is

   for Source_Dirs use ("src/", "config/");
   for Object_Dir use "obj/" & Zg6502_Config.Build_Profile;
   for Create_Missing_Dirs use "True";
   for Exec_Dir use "bin";
   for Main use ("zg6502.adb");

   package Compiler is
      for Default_Switches ("Ada") use Zg6502_Config.Ada_Compiler_Switches;
   end Compiler;

   package Binder is
      for Switches ("Ada") use ("-Es"); --  Symbolic traceback
   end Binder;

   package Install is
      for Artifacts (".") use ("share");
   end Install;

end Zg6502;
